# Copy this file to .env before running the app
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
DATABASE_URL=sqlite:///hospital_security.db

# Risk engine thresholds (0-100)
RISK_ALERT_THRESHOLD=60
RISK_AUTO_TERMINATE_THRESHOLD=80
MAX_FAILED_LOGIN_ATTEMPTS=4

# Behavioral biometrics
BEHAVIOR_BASELINE_MIN_SESSIONS=5
BEHAVIOR_DEVIATION_THRESHOLD=2.5
